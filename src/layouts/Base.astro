---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import { site, fullAddress } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props { title?: string; description?: string; }
const { title = site.seo.title, description = site.seo.description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL('/og-image.jpg', Astro.site);

const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

// Local business structured data, built from supplied details only.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutoWash',
  name: site.name,
  description: site.seo.description,
  url: Astro.site?.toString(),
  image: ogUrl.toString(),
  logo: new URL('/icon-512.png', Astro.site).toString(),
  telephone: site.contact.phone,
  foundingDate: String(site.established),
  areaServed: 'Townsville, QLD',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.contact.street,
    addressLocality: site.contact.suburb,
    addressRegion: site.contact.state,
    postalCode: site.contact.postcode,
    addressCountry: site.contact.countryCode,
  },
  hasMap: site.contact.directionsUrl,
  openingHoursSpecification: site.hours
    .filter((h) => h.open)
    .map((h) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: dayNames[h.day], opens: h.open, closes: h.close })),
};
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {site.isDemo && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${fullAddress}`} />
    <meta property="og:locale" content="en_AU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />

    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
