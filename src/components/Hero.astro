---
import { Image } from 'astro:assets';
import { site } from '../config/site';
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
// Unsplash, Jan Kopřiva (photo-1575844611398). A wash-bay advert panel in the background was softened into the mist.
import heroImg from '../assets/images/hero-mustang-wash.jpg';
---
<script is:inline>
  // First visit this session: play the full opening. Repeat visits / reduced motion: straight in.
  (function () {
    var d = document.documentElement, seen = false;
    try { seen = sessionStorage.getItem('pcd-intro') === '1'; sessionStorage.setItem('pcd-intro', '1'); } catch (e) {}
    if (!seen && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      d.classList.add('intro');
      setTimeout(function () { d.classList.add('intro-done'); }, 2600);
    }
  })();
</script>

<div class="intro" aria-hidden="true">
  <div class="lid t"></div>
  <div class="lid b"></div>
  <div class="mark"><Wordmark size="lg" /><span class="load"><i></i></span></div>
</div>

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="media" aria-hidden="true">
    <div class="parallax" data-parallax="0.16">
      <div class="frame">
        <Image
          src={heroImg}
          alt=""
          widths={[800, 1280, 1920, 2400]}
          sizes="(max-width: 719px) 300vw, 100vw"
          loading="eager"
          fetchpriority="high"
          quality={82}
        />
        <span class="lamp head"></span>
        <span class="lamp fog-l"></span>
        <span class="lamp fog-r"></span>
        <span class="mist m1"></span>
      </div>
    </div>
    <div class="shade"></div>
  </div>

  <div class="wrap content">
    <p class="kicker"><span class="bar"></span>Est. {site.established} · Townsville, QLD</p>

    <h1 id="hero-title">
      <span class="line"><span>Your vehicle.</span></span>
      <span class="line"><span>Our passion.</span></span>
      <span class="line accent"><span>Perfection in <br class="br" />every detail.</span></span>
    </h1>

    <div class="lower">
      <p class="lede">
        Premium car detailing and ceramic coating services throughout Townsville. Exceptional care, lasting protection and results worth showing off.
      </p>
      <div class="ctas">
        <a class="btn ghost" href="#services">Explore our services</a>
        <a class="btn" href={site.contact.phoneHref}><Icon name="phone" /> Call {site.contact.phone}</a>
      </div>
    </div>
  </div>

  <div class="wrap foot">
    <a class="status" href="#hours" data-status><i></i><span data-status-text>{site.hoursSummary}</span></a>
    <a class="scroll" href="#about"><span>Scroll</span><i></i></a>
    <a class="phone" href={site.contact.phoneHref}><Icon name="phone" /> {site.contact.phone}</a>
  </div>
</section>

<style>
  /* Timeline: t0 = when the scene starts revealing (later on a first visit, after the opening). */
  :global(html) { --t0: 0.1s; }
  :global(html.intro) { --t0: 1.35s; }

  /* ── Opening: wordmark, a red load line, then the frame splits open ── */
  .intro { display: none; }
  :global(html.intro) .intro {
    display: block; position: fixed; inset: 0; z-index: 200; pointer-events: none;
  }
  :global(html.intro-done) .intro { display: none; }
  .lid { position: absolute; left: 0; right: 0; height: 50.5%; background: #0a0a0b; animation: lid 1.1s var(--ease-in-out) 1.25s both; }
  .lid.t { top: 0; --dir: -100%; }
  .lid.b { bottom: 0; --dir: 100%; }
  @keyframes lid { to { transform: translateY(var(--dir)); } }
  .mark {
    position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 26px;
    animation: markIn 0.7s var(--ease) 0.1s both, markOut 0.45s var(--ease-in-out) 1.05s forwards;
  }
  @keyframes markIn { from { opacity: 0; transform: translateY(14px); letter-spacing: 0.02em; } }
  @keyframes markOut { to { opacity: 0; transform: scale(0.96); } }
  .load { width: 180px; height: 2px; background: rgba(255, 255, 255, 0.12); overflow: hidden; }
  .load i { display: block; height: 100%; background: var(--red-hot); transform-origin: left; animation: load 0.85s var(--ease-in-out) 0.25s both; }
  @keyframes load { from { transform: scaleX(0); } }
  :global(html.intro) :global(.header) { animation: hdr 0.9s var(--ease) calc(var(--t0) + 0.9s) both; }
  @keyframes hdr { from { opacity: 0; transform: translateY(-16px); } }

  .hero {
    position: relative; isolation: isolate;
    min-height: 100svh; min-height: max(640px, 100svh);
    display: grid; grid-template-rows: 1fr auto;
    background: var(--black); overflow: hidden;
  }

  /* ── Photo stack. The frame keeps the photo's own proportions so the lamp glows stay on the car. ── */
  .media { position: absolute; inset: 0; z-index: -1; }
  .parallax { position: absolute; inset: -6% 0; will-change: transform; container-type: size; }
  /* Desktop: the car sits right of the copy; the misty right edge of the photo runs off-screen. */
  .frame {
    --w: max(92cqw, 100cqh * 1.503);
    position: absolute; top: 50%; left: calc(100cqw - var(--w) * 0.82);
    width: var(--w); aspect-ratio: 2400 / 1597;
    transform: translateY(-50%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 16%);
    mask-image: linear-gradient(90deg, transparent 0, #000 16%);
  }
  .frame :global(img) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    filter: contrast(1.06) saturate(0.92);
  }

  .lamp { position: absolute; border-radius: 50%; mix-blend-mode: screen; pointer-events: none; opacity: 0.55; }
  .head { left: 42%; top: 46.5%; width: 14%; height: 8%; background: radial-gradient(closest-side, rgba(225, 240, 255, 0.95), rgba(190, 220, 255, 0.35) 45%, transparent); }
  .fog-l { left: 49%; top: 56.5%; width: 8%; height: 7%; background: radial-gradient(closest-side, rgba(255, 236, 205, 0.9), rgba(255, 190, 120, 0.3) 50%, transparent); }
  .fog-r { left: 72.5%; top: 56.5%; width: 7%; height: 7%; background: radial-gradient(closest-side, rgba(255, 236, 205, 0.85), rgba(255, 190, 120, 0.25) 50%, transparent); }

  .mist { position: absolute; pointer-events: none; mix-blend-mode: screen; opacity: 0.22; }
  .m1 { left: 10%; top: 52%; width: 70%; height: 45%; background: radial-gradient(closest-side, rgba(230, 230, 235, 0.55), transparent); animation: drift 16s ease-in-out infinite alternate; }
  @keyframes drift { from { transform: translate3d(-5%, 2%, 0) scale(1); } to { transform: translate3d(7%, -3%, 0) scale(1.12); } }

  .shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(10, 10, 11, 0.86) 0%, rgba(10, 10, 11, 0.5) 30%, rgba(10, 10, 11, 0) 56%),
      linear-gradient(0deg, rgba(10, 10, 11, 1) 0%, rgba(10, 10, 11, 0.35) 18%, rgba(10, 10, 11, 0) 34%),
      linear-gradient(180deg, rgba(10, 10, 11, 0.55) 0%, rgba(10, 10, 11, 0) 20%);
  }

  /* ── Copy ── */
  .content {
    align-self: end;
    padding-top: calc(var(--header-h) + 48px);
    padding-bottom: clamp(32px, 5vh, 56px);
    display: grid; gap: clamp(22px, 3.4vh, 36px);
  }
  .kicker {
    display: flex; align-items: center; gap: 14px;
    font-size: 12px; font-weight: 700; letter-spacing: 0.26em; text-transform: uppercase; color: rgba(255, 255, 255, 0.8);
  }
  .kicker .bar { width: 44px; height: 2px; background: var(--red); }

  h1 { font-size: clamp(40px, 5.8vw, 96px); line-height: 0.92; letter-spacing: -0.015em; text-shadow: 0 2px 30px rgba(0, 0, 0, 0.35); }
  .line { display: block; overflow: hidden; padding-bottom: 0.04em; }
  .line > span { display: block; }
  .accent { font-size: 0.62em; margin-top: 0.18em; text-shadow: none; }
  .accent > span { background: linear-gradient(90deg, var(--red-hot), var(--red) 60%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .br { display: none; }

  .lower { display: grid; gap: 28px; }
  .lede { max-width: 50ch; font-size: clamp(16px, 1.35vw, 19px); color: rgba(255, 255, 255, 0.84); }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }

  .foot {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding-block: 18px 22px; border-top: 1px solid var(--line-dark);
    font-size: 12px; color: var(--muted-on-dark);
  }
  .foot a { text-decoration: none; transition: color 0.3s; }
  .foot a:hover { color: #fff; }
  .foot .status { color: rgba(255, 255, 255, 0.8); }
  .phone { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; letter-spacing: 0.08em; color: #fff; }
  .phone :global(svg) { width: 16px; height: 16px; color: var(--red-hot); }
  .scroll { display: none; align-items: center; gap: 12px; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase; }
  .scroll i { position: relative; width: 1px; height: 34px; background: rgba(255, 255, 255, 0.2); overflow: hidden; }
  .scroll i::after { content: ''; position: absolute; left: 0; top: -40%; width: 1px; height: 40%; background: var(--red-hot); animation: drip 2.2s var(--ease-in-out) infinite; }
  @keyframes drip { to { top: 100%; } }

  @media (min-width: 720px) {
    .scroll { display: inline-flex; }
    .lower { grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 40px; }
    .br { display: inline; }
  }
  @media (max-width: 719px) {
    /* Centre the frame on the front of the car */
    /* Phone: the car fills the top half, fading into black behind the copy */
    .frame {
      --w: 205cqw; top: 3%; left: 50%; transform: translateX(-54%);
      -webkit-mask-image: linear-gradient(180deg, #000 72%, transparent 96%);
      mask-image: linear-gradient(180deg, #000 72%, transparent 96%);
    }
    .shade {
      background:
        linear-gradient(0deg, rgba(10, 10, 11, 1) 4%, rgba(10, 10, 11, 0.9) 44%, rgba(10, 10, 11, 0) 62%),
        linear-gradient(180deg, rgba(10, 10, 11, 0.55) 0%, rgba(10, 10, 11, 0) 20%);
    }
    h1 { font-size: clamp(28px, 8.3vw, 40px); }
    .content { gap: 20px; }
    .ctas .btn { flex: 1 1 100%; }
    .foot .phone { display: none; }
  }

  /* Portrait tablets: whole car across the top, copy below */
  @media (min-width: 720px) and (max-aspect-ratio: 1/1) {
    .lower { grid-template-columns: 1fr; gap: 24px; }
    .frame {
      --w: 150cqw; top: 3%; left: 50%; transform: translateX(-50%);
      -webkit-mask-image: linear-gradient(180deg, #000 72%, transparent 96%);
      mask-image: linear-gradient(180deg, #000 72%, transparent 96%);
    }
    .shade {
      background:
        linear-gradient(0deg, rgba(10, 10, 11, 1) 4%, rgba(10, 10, 11, 0.88) 34%, rgba(10, 10, 11, 0) 50%),
        linear-gradient(180deg, rgba(10, 10, 11, 0.55) 0%, rgba(10, 10, 11, 0) 16%);
    }
  }

  /* ── Entrance: dark bay, headlights flick on, the scene lifts into light ── */
  :global(.js) .frame { animation: settle 2.6s var(--ease) var(--t0) both; }
  @keyframes settle {
    from { scale: 1.14; filter: brightness(0.12); }
    35% { filter: brightness(0.4); }
  }
  :global(.js) .lamp { animation: lampsOn 2.4s linear calc(var(--t0) + 0.25s) both, breathe 5s ease-in-out calc(var(--t0) + 2.7s) infinite alternate; }
  :global(.js) .fog-l, :global(.js) .fog-r { animation-delay: calc(var(--t0) + 0.4s), calc(var(--t0) + 2.8s); }
  @keyframes lampsOn {
    0% { opacity: 0; }
    6% { opacity: 1; } 10% { opacity: 0.15; } 15% { opacity: 1; }
    40% { opacity: 1; }
    100% { opacity: 0.55; }
  }
  @keyframes breathe { to { opacity: 0.38; } }
  :global(.js) .mist { animation-name: drift, mistIn; animation-duration: 16s, 3s; animation-delay: 0s, var(--t0); animation-fill-mode: none, both; animation-iteration-count: infinite, 1; animation-timing-function: ease-in-out, var(--ease); }
  :global(.js) .m1 { animation-direction: alternate, normal; }
  @keyframes mistIn { from { opacity: 0; } }

  :global(.js) .line > span { animation: lift 1.2s var(--ease) both; }
  :global(.js) .line:nth-child(1) > span { animation-delay: calc(var(--t0) + 0.5s); }
  :global(.js) .line:nth-child(2) > span { animation-delay: calc(var(--t0) + 0.62s); }
  :global(.js) .line:nth-child(3) > span { animation-delay: calc(var(--t0) + 0.78s); }
  @keyframes lift { from { transform: translateY(105%); } }
  :global(.js) .kicker, :global(.js) .lower, :global(.js) .foot { animation: fade 1.2s var(--ease) both; }
  :global(.js) .kicker { animation-delay: calc(var(--t0) + 0.35s); }
  :global(.js) .lower { animation-delay: calc(var(--t0) + 1s); }
  :global(.js) .foot { animation-delay: calc(var(--t0) + 1.25s); }
  @keyframes fade { from { opacity: 0; transform: translateY(20px); } }

  @media (prefers-reduced-motion: reduce) {
    .mist, .lamp, .frame { animation: none !important; }
  }
</style>
