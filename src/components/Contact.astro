---
import { Image } from 'astro:assets';
import { site, fullAddress } from '../config/site';
import Icon from './Icon.astro';
import bg from '../assets/images/hero-black-car-red-light.jpg';
---
<section class="contact" id="contact" aria-labelledby="contact-title">
  <!-- CTA band -->
  <div class="cta">
    <div class="cta-bg" aria-hidden="true">
      <div data-parallax="0.15" class="cta-par">
        <Image src={bg} alt="" widths={[800, 1280, 1920, 2400]} sizes="100vw" />
      </div>
    </div>
    <div class="wrap cta-inner">
      <p class="label" data-reveal><span><b>06</b> &nbsp;Contact</span></p>
      <h2 class="display" id="contact-title" data-reveal>Ready to give your vehicle the <em>Prestige</em> treatment?</h2>
      <p class="sub" data-reveal>Get in touch with Prestige Car Detailing Townsville to discuss your vehicle and find the right detailing solution.</p>
      <div class="cta-btns" data-reveal>
        <a class="btn big" href={site.contact.phoneHref}><Icon name="phone" /> Call {site.contact.phone}</a>
        <a class="btn ghost" href="#hours">Opening hours</a>
      </div>
    </div>
  </div>

  <!-- Phone, hours, location -->
  <div class="panel on-light">
    <div class="wrap grid">
      <div class="block phone-block" data-reveal>
        <h3><Icon name="phone" /> Call us</h3>
        <a class="phone" href={site.contact.phoneHref}>{site.contact.phone}</a>
        <p class="note">Call to discuss your vehicle, ask about services or book a time.</p>
        <a class="btn" href={site.contact.phoneHref}><Icon name="phone" /> Call now</a>
      </div>

      <div class="block" id="hours" data-reveal style="--d:0.08s">
        <h3><Icon name="clock" /> Opening hours</h3>
        <p class="status" data-status><i></i><span data-status-text>{site.hoursSummary}</span></p>
        <table class="hours">
          <caption class="visually-hidden">Opening hours</caption>
          <tbody>
            {site.hours.map((h) => (
              <tr data-day={h.day} class:list={{ closed: !h.open }}>
                <th scope="row">{h.label}</th>
                <td>{h.time}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="block" data-reveal style="--d:0.16s">
        <h3><Icon name="pin" /> Location</h3>
        <address>{site.contact.street}<br />{site.contact.suburb} {site.contact.state} {site.contact.postcode}</address>
        <a class="link" href={site.contact.directionsUrl} target="_blank" rel="noopener">Get directions <Icon name="arrow" /></a>
      </div>
    </div>

    <div class="map wrap">
      <div class="map-frame" data-reveal>
        <iframe src={site.contact.mapEmbedUrl} title={`Map showing ${fullAddress}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  /* CTA */
  .cta { position: relative; isolation: isolate; overflow: hidden; background: var(--black); }
  .cta-bg { position: absolute; inset: 0; z-index: -1; }
  .cta-par { position: absolute; inset: -10% 0; }
  .cta-bg :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 45%; filter: brightness(1.5) contrast(1.05); }
  .cta-bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(10,10,11,0.85) 0%, rgba(10,10,11,0.35) 55%, rgba(10,10,11,0) 80%), linear-gradient(0deg, rgba(10,10,11,0.7), transparent 35%); }
  .cta-inner { display: grid; gap: 26px; justify-items: start; padding-block: clamp(110px, 14vw, 200px); }
  .cta-inner .display { font-size: clamp(36px, 6vw, 92px); max-width: 15ch; }
  .sub { max-width: 48ch; color: rgba(255, 255, 255, 0.8); font-size: clamp(16px, 1.4vw, 19px); }
  .cta-btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .btn.big { min-height: 64px; padding: 0 32px; font-size: 14px; }

  /* Panel */
  .panel { padding-block: clamp(72px, 9vw, 130px) 0; }
  .grid { display: grid; gap: 56px; }
  @media (min-width: 760px) { .grid { grid-template-columns: 1fr 1fr; } .phone-block { grid-column: 1 / -1; } }
  @media (min-width: 1100px) { .grid { grid-template-columns: 1.25fr 1fr 0.9fr; gap: clamp(48px, 5vw, 80px); } .phone-block { grid-column: auto; } }

  .block { display: grid; gap: 16px; justify-items: start; align-content: start; }
  .block h3 { display: flex; align-items: center; gap: 10px; font-size: 11px; font-stretch: 100%; letter-spacing: 0.22em; color: var(--muted-on-light); }
  .block h3 :global(svg) { width: 16px; height: 16px; color: var(--red); }
  .phone { display: inline-flex; align-items: center; min-height: 56px; white-space: nowrap; font-size: clamp(32px, 3.3vw, 48px); font-weight: 900; font-stretch: 125%; text-decoration: none; line-height: 1; letter-spacing: -0.01em; transition: color 0.3s; }
  .phone:hover { color: var(--red); }
  .note { color: var(--muted-on-light); max-width: 36ch; }
  address { font-style: normal; font-size: 22px; font-weight: 800; font-stretch: 115%; text-transform: uppercase; line-height: 1.2; }
  .block .status { color: var(--ink); }

  .hours { width: 100%; max-width: 420px; border-collapse: collapse; font-size: 15px; }
  .hours th, .hours td { padding: 10px 0; border-bottom: 1px solid var(--line-light); text-align: left; font-weight: 500; }
  .hours td { text-align: right; font-variant-numeric: tabular-nums; }
  .hours tr.closed td { color: var(--muted-on-light); }
  .hours tr:global(.today) th, .hours tr:global(.today) td { font-weight: 800; color: var(--ink); }
  .hours tr:global(.today) th::after { content: 'Today'; margin-left: 10px; font-size: 9px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: #fff; background: var(--red); padding: 3px 7px; vertical-align: 2px; }

  .map { margin-top: clamp(64px, 8vw, 110px); padding-bottom: clamp(64px, 8vw, 110px); }
  .map-frame { position: relative; height: clamp(300px, 36vw, 440px); overflow: hidden; background: var(--paper); }
  .map-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; filter: grayscale(1) contrast(1.05); transition: filter 0.6s; }
  .map-frame:hover iframe { filter: grayscale(0.2); }
</style>
