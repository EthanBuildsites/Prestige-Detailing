---
/** Typeset wordmark echoing the logo: wide "PRESTIGE", red tracked sub-line, tail-light swoosh. */
interface Props { size?: 'sm' | 'lg'; }
const { size = 'sm' } = Astro.props;
---
<span class:list={['wm', size]}>
  <svg class="swoosh" viewBox="0 0 120 14" aria-hidden="true"><path d="M1 12.5C22 4 52 1.2 84 2.2c13 .4 24 2.3 35 5.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  <span class="top">Prestige</span>
  <span class="sub">Car Detailing <i>·</i> Townsville</span>
</span>

<style>
  .wm { display: inline-grid; line-height: 1; color: #fff; position: relative; padding-top: 6px; }
  .swoosh { position: absolute; left: -2px; top: -3px; width: 62%; height: auto; color: var(--red); }
  .top { font-weight: 900; font-stretch: 125%; text-transform: uppercase; letter-spacing: 0.06em; font-size: 21px; }
  .sub { margin-top: 5px; font-size: 8.5px; font-weight: 700; letter-spacing: 0.32em; text-transform: uppercase; color: var(--red-hot); white-space: nowrap; }
  .sub i { font-style: normal; color: rgba(255,255,255,0.5); }
  @media (max-width: 420px) {
    .sm .top { font-size: 18px; }
    .sm .sub { font-size: 8px; letter-spacing: 0.18em; }
  }
  .lg .top { font-size: clamp(30px, 4vw, 44px); }
  .lg .sub { font-size: clamp(10px, 1.1vw, 12px); margin-top: 10px; }
  .lg .swoosh { top: -8px; }
</style>
